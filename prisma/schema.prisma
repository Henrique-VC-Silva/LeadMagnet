generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id          String   @id @default(cuid())
  email       String
  name        String?
  phone       String?
  campaign    String?
  consent     Boolean  @default(false)
  consentAt   DateTime @default(now())
  wonPrizeId  String?
  wonPrize    Prize?   @relation(fields: [wonPrizeId], references: [id])
  createdAt   DateTime @default(now())

  @@index([email])
}

model Prize {
  id          String   @id @default(cuid())
  name        String
  weight      Int      @default(1)
  stock       Int      @default(0)
  code        String?
  isNoPrize   Boolean  @default(false)
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
