generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  primaryColor   String   @default("#c5a059")
  secondaryColor String   @default("#f1f1f1")
  backgroundImage String?
  logo            String?
  copyTitle       String?
  copySubtitle    String?
  copyButton      String?
  isActive        Boolean  @default(true)
  prizes         Prize[]
  leads          Lead[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id          String    @id @default(cuid())
  email       String
  name        String?
  phone       String?
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  consent     Boolean   @default(false)
  consentAt   DateTime  @default(now())
  wonPrizeId  String?
  wonPrize    Prize?    @relation(fields: [wonPrizeId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Prize {
  id          String    @id @default(cuid())
  name        String
  weight      Int       @default(1)
  stock       Int       @default(0)
  code        String?
  isNoPrize   Boolean   @default(false)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  leads       Lead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
